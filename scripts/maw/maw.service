# Template rendered by install.sh (@NODE_BIN@, @STATE_DIR@, @PATH@, @RUNTIME_NAME@).
# The service always boots `current`; only the restart helper changes `current` (see maw-lib.sh).
[Unit]
Description=My Amazing Workspace
# Start maw-ptyd.service if not already running so the persistent supervisor is available.
# Restarting maw.service does NOT stop maw-ptyd.service (no PartOf=).
Wants=maw-ptyd.service
After=network.target maw-ptyd.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=@STATE_DIR@/current
ExecStartPre=/usr/bin/test -f @STATE_DIR@/current/.maw-release-meta.json
ExecStartPre=/usr/bin/test -f @STATE_DIR@/current/packages/server/src/maw-host.ts
ExecStart=@NODE_BIN@ --import @STATE_DIR@/current/packages/server/node_modules/tsx/dist/loader.mjs @STATE_DIR@/current/packages/server/src/index.ts --prod
Environment=PATH=@PATH@
Environment=AGENT_WORKBENCH_NO_OPEN=1
Environment=MAW_RUNTIME_DIR=%t/@RUNTIME_NAME@
# Optional persistent connection settings; secrets never belong in a release.
EnvironmentFile=-@ENV_FILE@
RuntimeDirectory=@RUNTIME_NAME@
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maw
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=default.target
