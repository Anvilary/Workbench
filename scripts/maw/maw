#!/bin/sh
set -eu

: "${HOME:?HOME is required}"
lib_dir="${MAW_LIB_DIR:-$HOME/.local/lib/maw}"
self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# Scripts live next to this launcher in the repository, or in the installed library directory.
script_dir="$self_dir"
[ -f "$script_dir/maw-lib.sh" ] || script_dir="$lib_dir"
# shellcheck source=maw-lib.sh
. "$script_dir/maw-lib.sh"
maw_init_paths

control_script="${MAW_CONTROL_SCRIPT:-$script_dir/control.mjs}"
update_script="${MAW_UPDATE_SCRIPT:-$script_dir/maw-update.sh}"
restart_helper="${MAW_RESTART_HELPER:-$script_dir/maw-restart-helper.sh}"

usage() { printf '%s\n' 'Usage: maw {start|stop|restart|rollback|status|logs [--follow]|url|open [browser]|update [--no-restart|--restart] [--ref <ref> --allow-unapproved-ref]|help}'; }

# True when this command runs inside the MAW service (its PTYs inherit the unit's cgroup), or descends
# from the service's main process (e.g. a PTY moved into another scope). Exact cgroup path component.
is_inside_maw() {
  cgroup_file="${MAW_CGROUP_FILE:-/proc/self/cgroup}"
  if [ -r "$cgroup_file" ] && awk -F: -v u="$unit" '
      { n = split($3, parts, "/"); for (i = 1; i <= n; i++) if (parts[i] == u) found = 1 }
      END { exit found ? 0 : 1 }' "$cgroup_file"; then
    return 0
  fi
  maw_pid=$(maw_sctl show "$unit" --property=MainPID --value 2>/dev/null || true)
  if [ -n "$maw_pid" ] && [ "$maw_pid" -gt 0 ] 2>/dev/null; then
    check_pid=$$
    while [ -n "$check_pid" ] && [ "$check_pid" -gt 1 ] 2>/dev/null; do
      check_pid=$(ps -o ppid= -p "$check_pid" 2>/dev/null | tr -d ' ') || break
      case "$check_pid" in ''|*[!0-9]*) break ;; esac
      [ "$check_pid" = "$maw_pid" ] && return 0
    done
  fi
  return 1
}

run_activation() {   # extra helper args...
  printf '%s\n' 'Warning: Active server-owned live PTYs will terminate. Original PTY will not survive.' >&2
  printf '%s\n' 'Metadata and native history remain. Eligible verified native conversations use replacement PTYs during recovery.' >&2
  if is_inside_maw; then
    if maw_restart_locked; then
      printf '%s\n' 'A restart is already in progress or scheduled. Duplicate restart avoided.' >&2
      exit 1
    fi
    printf '%s\n' 'Restarting MAW from inside MAW. Delegating restart outside service control group...' >&2
    # Fixed unit name: systemd itself rejects a second scheduled restart. --collect frees the name even
    # when the helper exits non-zero. The helper's environment is passed explicitly (systemd-run does not
    # inherit the caller's).
    _extra_setenv=""
    [ -z "${MAW_SYSTEMD_RUNTIME_DIR:-}" ] || _extra_setenv="--setenv=MAW_SYSTEMD_RUNTIME_DIR=$MAW_SYSTEMD_RUNTIME_DIR"
    _extra_bus_setenv=""
    [ -z "${MAW_SYSTEMD_BUS_ADDRESS:-}" ] || _extra_bus_setenv="--setenv=MAW_SYSTEMD_BUS_ADDRESS=$MAW_SYSTEMD_BUS_ADDRESS"
    if maw_systemd_run \
        --unit="${MAW_HELPER_UNIT:-maw-restart-helper}" \
        --collect \
        --no-block \
        --description="MAW safe restart helper" \
        --on-active=1 \
        --setenv=HOME="$HOME" \
        --setenv=PATH="$PATH" \
        --setenv=MAW_STATE_DIR="$state_dir" \
        --setenv=MAW_RELEASES_DIR="$releases_dir" \
        --setenv=MAW_LOG_FILE="$log_file" \
        --setenv=MAW_UPDATE_LOCK="$update_lock" \
        --setenv=MAW_RUNTIME_DIR="$runtime_dir" \
        --setenv=MAW_RESTART_LOCK="$restart_lock" \
        --setenv=MAW_NODE_BIN="$node_bin" \
        --setenv=MAW_CONTROL_SCRIPT="$control_script" \
        ${_extra_setenv:+"$_extra_setenv"} \
        ${_extra_bus_setenv:+"$_extra_bus_setenv"} \
        /bin/sh "$restart_helper" --unit "$unit" "$@"; then
      printf '%s\n' "Safe restart scheduled (transient unit: ${MAW_HELPER_UNIT:-maw-restart-helper})."
      printf '%s\n' "Your terminal session will be interrupted shortly. The outcome is recorded in $log_file; check it with: maw status"
      exit 0
    fi
    printf '%s\n' 'Error: Failed to schedule safe restart (another restart may already be scheduled).' >&2
    exit 1
  fi
  exec /bin/sh "$restart_helper" --unit "$unit" "$@"
}

command_name=${1:-help}
case "$command_name" in
  start)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    if [ "$(maw_sctl show "$unit" --property=ActiveState --value 2>/dev/null || true)" = active ]; then
      exec /bin/sh "$restart_helper" --unit "$unit" --start
    fi
    run_activation --start
    ;;
  stop)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    printf '%s\n' 'Server-owned live PTYs will terminate. Metadata and native history remain.' >&2
    maw_sctl stop "$unit"
    exit $?
    ;;
  restart)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    run_activation
    ;;
  rollback)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    previous=$(maw_pointer previous)
    [ -n "$previous" ] || { printf '%s\n' 'No verified previous release is available.' >&2; exit 1; }
    printf '%s\n' 'Executable rollback does not guarantee historical-data compatibility; older releases cannot display split session history.' >&2
    maw_lock_update 0 || { printf '%s\n' 'An update or activation is in progress.' >&2; exit 1; }
    maw_set_pointer staged "$previous"
    exec 9>&-
    maw_log rollback-requested release "$(basename "$previous")"
    printf '%s\n' "Activating previous verified release $(basename "$previous")..."
    run_activation
    ;;
  status)
    maw_sctl show "$unit" --property=ActiveState,SubState,MainPID,ExecMainStatus || true
    for p in current staged healthy previous; do
      t=$(maw_pointer_raw "$p")
      printf '%-9s%s\n' "$p:" "${t:+$(basename "$t")}"
    done
    if [ -n "$(maw_pointer_raw current)" ] && [ "$(maw_pointer_raw current)" != "$(maw_pointer_raw healthy)" ]; then
      printf '%s\n' 'Note: current is not the verified healthy release (unverified activation or legacy layout).'
    fi
    if [ -f "$log_file" ]; then printf 'last:    %s\n' "$(tail -n 1 "$log_file")"; fi
    exec "$node_bin" "$control_script" status
    ;;
  logs)
    case "${2:-}" in
      '') maw_journalctl -u "$unit" -n 80 --no-pager; exit $? ;;
      --follow|-f) maw_journalctl -u "$unit" -n 80 --follow; exit $? ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  url)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    exec "$node_bin" "$control_script" url
    ;;
  open)
    case "$#" in
      1) exec "$node_bin" "$control_script" open ;;
      2) exec "$node_bin" "$control_script" open "$2" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  update)
    exec /bin/sh "$update_script" "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
