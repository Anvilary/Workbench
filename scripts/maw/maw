#!/bin/sh
set -eu
unit=maw.service
node_bin=$(command -v node 2>/dev/null || printf '%s' '/home/alteixeira20/.nvm/versions/node/v24.22.0/bin/node')
[ -n "$node_bin" ] || node_bin='/home/alteixeira20/.nvm/versions/node/v24.22.0/bin/node'
self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$self_dir/control.mjs" ]; then
  control_script="$self_dir/control.mjs"
else
  control_script=/home/alteixeira20/.local/lib/maw/control.mjs
fi
usage() { printf '%s\n' 'Usage: maw {start|stop|restart|status|logs [--follow]|url|open [browser]|help}'; }
command_name=${1:-help}
case "$command_name" in
  start) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; exec systemctl --user start "$unit" ;;
  stop|restart)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    printf '%s\n' 'Server-owned live PTYs will terminate. Metadata and native history remain.' >&2
    if [ "$command_name" = restart ]; then
      printf '%s\n' 'Eligible verified native conversations use replacement PTYs during recovery.' >&2
    fi
    exec systemctl --user "$command_name" "$unit" ;;
  status)
    systemctl --user show "$unit" --property=ActiveState,SubState,MainPID,ExecMainStatus
    exec "$node_bin" "$control_script" status ;;
  logs)
    case "${2:-}" in
      '') exec journalctl --user -u "$unit" -n 80 --no-pager ;;
      --follow|-f) exec journalctl --user -u "$unit" -n 80 --follow ;;
      *) usage >&2; exit 2 ;;
    esac ;;
  url)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    exec "$node_bin" "$control_script" url ;;
  open)
    case "$#" in
      1) exec "$node_bin" "$control_script" open ;;
      2) exec "$node_bin" "$control_script" open "$2" ;;
      *) usage >&2; exit 2 ;;
    esac ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
