{
  "name": "@agent-workbench/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test policy.test.mjs file-clipboard.test.mjs resource-budget.test.mjs resource-monitor.test.mjs",
    "test:electron": "node --test --test-concurrency=1 smoke.test.mjs nautilus-clipboard.test.mjs download-smoke.test.mjs resource-tab-pool.test.mjs",
    "bench:webview": "node bench/webview-benchmarks.mjs all",
    "bench:lifecycle": "node bench/webview-benchmarks.mjs lifecycle",
    "bench:tab-switch": "node bench/webview-benchmarks.mjs tab-switch",
    "bench:pane-resize": "node bench/webview-benchmarks.mjs pane-resize",
    "bench:overlay-capture": "node bench/webview-benchmarks.mjs overlay-capture",
    "bench:concurrent-stream": "node bench/webview-benchmarks.mjs lifecycle",
    "bench:resource-matrix": "node bench/webview-benchmarks.mjs resource-matrix"
  },
  "devDependencies": {
    "electron": "45.2.0"
  }
}
