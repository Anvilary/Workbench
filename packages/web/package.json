{
  "name": "@agent-workbench/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interfaz de Agent Workbench",
  "scripts": {
    "build": "vite build",
    "test:unit": "tsx --test \"tests/unit/**/*.test.{mjs,ts}\"",
    "test:integration": "tsx --test --test-concurrency=2 \"tests/integration/**/*.test.mjs\"",
    "test:e2e": "tsx --test --test-concurrency=2 \"tests/e2e/**/*.test.mjs\"",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-workbench/shared": "workspace:*",
    "@dnd-kit/collision": "0.5.1",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.12.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.20.3",
    "vite": "^6.3.5"
  }
}
