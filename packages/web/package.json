{
  "name": "@agent-workbench/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interfaz de Agent Workbench",
  "scripts": {
    "build": "vite build",
    "test:unit": "tsx --test tests/unit/agents/*.test.mjs tests/unit/browser/*.test.mjs tests/unit/editor/*.test.mjs tests/unit/panes/*.test.* tests/unit/settings/*.test.mjs tests/unit/shared/*.test.mjs tests/unit/terminals/*.test.mjs tests/unit/workspaces/*.test.mjs",
    "test:integration": "tsx --test tests/integration/browser/useNativeChatGptTabs.test.mjs tests/integration/panes/*.test.mjs tests/integration/workspaces/*.test.mjs",
    "test:e2e": "tsx --test tests/e2e/browser/*.test.mjs tests/e2e/panes/pane-inspection.test.mjs tests/e2e/panes/split-divider-lifecycle.test.mjs tests/e2e/panes/tab-close-lifecycle.test.mjs tests/e2e/panes/tab-dnd-acceptance.test.mjs tests/e2e/panes/tab-scroll-ergonomics.test.mjs tests/e2e/settings/*.test.mjs tests/e2e/terminals/*.test.mjs tests/e2e/workspaces/sidebar-ux-acceptance.test.mjs tests/e2e/workspaces/notifications-browser-acceptance.test.mjs",
    "test": "tsx --test tests/unit/shared/shared-foundations.test.mjs tests/unit/agents/agents-usage-view.test.mjs tests/unit/terminals/terminal-output.test.mjs tests/unit/workspaces/model.test.mjs tests/integration/browser/useNativeChatGptTabs.test.mjs tests/integration/workspaces/notifications.test.mjs tests/e2e/workspaces/notifications-browser-acceptance.test.mjs tests/unit/editor/editor-drafts.test.mjs tests/unit/panes/tab-geometry.test.mjs tests/unit/terminals/terminal-path.test.mjs tests/e2e/panes/tab-dnd-acceptance.test.mjs tests/unit/browser/browser-destination-picker.test.mjs tests/e2e/terminals/terminal-input-isolation.test.mjs tests/unit/terminals/terminal-input-gate.test.mjs tests/unit/terminals/terminal-buffer.test.mjs tests/e2e/terminals/terminal-clipboard-acceptance.test.mjs tests/integration/workspaces/performance-panel.test.mjs tests/unit/terminals/useTerminalHistory.test.mjs tests/e2e/terminals/terminal-paste-history-regression.test.mjs tests/unit/settings/useTheme.test.mjs tests/e2e/workspaces/sidebar-ux-acceptance.test.mjs tests/unit/browser/browser-context-menu.test.mjs tests/unit/workspaces/sidebar-dropdown-position.test.mjs tests/e2e/settings/settings-dialog-redesign.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-workbench/shared": "workspace:*",
    "@dnd-kit/collision": "0.5.1",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.12.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.20.3",
    "vite": "^6.3.5"
  }
}
