{
  "name": "agent-workbench",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Local visual interface for coding-agent CLIs: Claude Code, Codex, OpenCode, Antigravity CLI and Pi",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "pi",
    "coding-agent",
    "ai-agents",
    "terminal",
    "pty",
    "xterm",
    "developer-tools",
    "cli",
    "ui"
  ],
  "license": "MIT",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/cvelasquez"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "desktop": "node scripts/desktop-prototype.mjs",
    "desktop:prototype": "node scripts/desktop-prototype.mjs",
    "dev": "pnpm --filter @agent-workbench/server dev",
    "build": "node scripts/maw/check-desktop-build.mjs && node packages/server/scripts/build-bundle.mjs && pnpm --filter @agent-workbench/web build",
    "start": "pnpm --filter @agent-workbench/server start",
    "package": "node scripts/package.mjs",
    "build:npm": "node scripts/build-npm.mjs",
    "typecheck": "pnpm -r typecheck",
    "vault:import": "pnpm --filter @agent-workbench/server vault:import",
    "check": "pnpm --filter @agent-workbench/server check",
    "test": "pnpm --filter @agent-workbench/desktop test && pnpm --filter @agent-workbench/server test && pnpm --filter @agent-workbench/web test",
    "perf": "node scripts/perf-check.mjs",
    "perf:full": "node scripts/perf-check.mjs full",
    "demo": "node scripts/demo/run.mjs",
    "demo:shots": "node scripts/demo/shots.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3"
  },
  "mawCompatibility": {
    "browserTabStore": 2
  }
}
