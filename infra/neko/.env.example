# Neko Browser Runtime Environment Configuration
# All endpoints bind exclusively to loopback 127.0.0.1 for local MAW security.

# Screen resolution and frame rate
NEKO_DESKTOP_SCREEN=1280x720@30

# Neko member passwords (override with strong random values in production)
NEKO_PASSWORD=neko
NEKO_ADMIN_PASSWORD=admin

# Optional shared bearer authentication secret for the restricted tab controller
# If unset, local loopback access does not require a bearer header.
CONTROLLER_AUTH_TOKEN=
