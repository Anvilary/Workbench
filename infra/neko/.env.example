# MAW Neko Browser Runtime Environment Configuration
# Copy this file to .env and configure strong, unique secrets.
# All network services bind exclusively to loopback 127.0.0.1.

# Screen resolution and frame rate
NEKO_DESKTOP_SCREEN=1280x720@30

# Neko user and admin passwords (MANDATORY: minimum 16 characters each, no defaults)
# Generate with: openssl rand -hex 16
NEKO_PASSWORD=
NEKO_ADMIN_PASSWORD=

# Restricted CDP Tab Controller authentication token (MANDATORY: minimum 32 characters)
# Generate with: openssl rand -hex 24
CONTROLLER_AUTH_TOKEN=
